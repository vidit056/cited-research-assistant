# Google Cloud Vertex AI Configuration
GOOGLE_CLOUD_PROJECT=project-537fe30e-f4c9-4e18-8c3
VERTEX_LOCATION=global

# Search Provider (Tavily)
TAVILY_API_KEY=your-tavily-api-key-here

# Database Configuration (Defaults to SQLite in .data/app.db)
DATABASE_URL=sqlite:///.data/app.db

# Per-step Model Configuration (All default to gemini-3.7-flash for v1)
MODEL_PLAN=gemini-3.7-flash
MODEL_RETRIEVE=gemini-3.7-flash
MODEL_SYNTH=gemini-3.7-flash
MODEL_VERIFY=gemini-3.7-flash
EMBEDDING_MODEL=text-embedding-004

# Chroma Vector Store Path
CHROMA_PERSIST_DIR=.data/chroma
